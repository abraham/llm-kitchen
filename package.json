{
	"name": "llm-kitchen",
	"private": true,
	"license": "MIT",
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"start": "vite dev",
		"build": "node scripts/build-og.ts && vite build",
		"preview": "vite preview",
		"serve": "firebase emulators:start --only hosting --project demo-llm-kitchen",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"test": "vitest run",
		"test:python": "scripts/.venv/bin/python -m pytest -p no:cacheprovider scripts/tests",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:lighthouse": "playwright test --config playwright.lighthouse.config.ts",
		"test:visual": "playwright test --config playwright.visual.config.ts"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.1",
		"@playwright/test": "^1.65.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"firebase-tools": "^15.35.0",
		"globals": "^17.14.0",
		"lighthouse": "^13.6.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"temml": "^0.14.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vitest": "^5.1.0",
		"wawoff2": "^2.0.1"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.3.2",
		"@noble/hashes": "^2.4.0",
		"gpt-tokenizer": "^4.1.0"
	},
	"overrides": {
		"superstatic": "^11.1.0"
	}
}
